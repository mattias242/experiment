# Write-only-token för push-notiser via ntfy (notify.neomeda.eu).
# Kontot heter "hamtning" och får bara skriva till topics hamtning* och
# neomeda-all. Skapa en token:
#   ssh mattiaswahlberg@192.168.1.110 \
#     "/var/packages/ContainerManager/target/usr/bin/docker exec ntfy ntfy token add --label hamtning-app hamtning"
# Utan token startar appen ändå – påminnelserna är då tyst avstängda.
NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxx
